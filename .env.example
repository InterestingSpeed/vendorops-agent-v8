# Recommended demo mode: Groq Fast Hybrid. One small planner call only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Offline backup. Only ONE model is required for this project.
# Install Ollama separately, then: ollama pull qwen3:4b
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Advanced full-agent limits
LLM_MAX_STEPS=20
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=320
GROQ_RATE_LIMIT_RETRIES=3
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=25

VENDOROPS_DB_PATH=data/vendorops.db
